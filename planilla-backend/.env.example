# Base de datos (Railway la inyecta sola si el servicio está en el mismo proyecto).
DATABASE_URL=postgresql://usuario:clave@host:puerto/base
# Opcional: usa un esquema propio dentro de la base (útil si comparte base con otro sistema).
# DB_SCHEMA=planilla

# Firma de las sesiones. Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Clave que usa el sitio sticr.app para crear y suspender empresas (mínimo 24 caracteres).
# Debe ser la misma que PLANILLA_PROVISION_SECRET en el sitio. Sin ella, esas rutas quedan apagadas.
PROVISION_SECRET=

# Empresa demo pública (subdominio "demo"): se crea al arrancar y se restablece sola.
DEMO_ENABLED=false
DEMO_RESET_HOURS=6

# Solo para instalaciones individuales antiguas. En el servicio compartido déjalo apagado.
ALLOW_PUBLIC_REGISTRATION=false

# Orígenes (sitios web) que pueden llamar a la API desde un navegador, separados por comas.
# Si no la defines: https://sticr.app, cualquier https://<algo>.sticr.app y, fuera de producción, http://localhost:<puerto>.
# CORS_ORIGINS=https://sticr.app,https://planilla.sticr.app,https://demo.sticr.app

# Cuántos proxies hay delante del servicio (Railway: 1). Por defecto: 1 si NODE_ENV=production, 0 si no.
# Se usa para saber la IP real del cliente en el límite de intentos de login.
# TRUST_PROXY=1

# Límite de intentos fallidos de login (por IP y por usuario). Por defecto 10 intentos cada 15 minutos.
# LOGIN_MAX_INTENTOS=10
# LOGIN_VENTANA_MINUTOS=15

# Solo para `npm run seed-admin`: contraseña del administrador inicial (mínimo 8 caracteres). No hay valor por defecto.
# ADMIN_PASSWORD=

# Solo para `npm test`: base de datos DESECHABLE de pruebas (el nombre debe contener "test"). Nunca la de producción.
# TEST_DATABASE_URL=postgresql://postgres@localhost:5432/planilla_test
